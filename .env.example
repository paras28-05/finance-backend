# Copy this file to .env and edit the values.
# The application works without a .env file using default values.

# IMPORTANT: Change this to a long random string in production!
SECRET_KEY=zorvyn-finance-super-secret-key-change-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite (default) — no setup required:
DATABASE_URL=sqlite:///./finance.db

# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_db
